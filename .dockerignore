# Python
.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/

# Node
client/webapp/node_modules/
**/.npm/

# Data — mounted at runtime via volume
data/
!data/__init__.py
!data/database.py
# Exception: knowledge citations từ sách phải vào image (version-controlled,
# không phụ thuộc VPS volume mount). Dockerfile COPY explicit.
!data/hermes_yi/
!data/hermes_yi/skills/
!data/hermes_yi/skills/kinh-dich/
!data/hermes_yi/skills/kinh-dich/**
# Restored books (markdown phục chế) — vào image để live đọc được
# CHỈ content.md (skip pages/*.raw.txt to keep image gọn)
!data/restored_books/
!data/restored_books/**/content.md
!data/restored_books/**/manifest.json
!data/restored_books/markitdown_batch_summary.json

# Seed JSON — paradigm engines load runtime (cung Phu Thê, Mai Hoa, Bát Tự...)
# Version-controlled qua git add -f (gitignored nhưng commit explicit)
!data/seeds/
!data/seeds/**/*.json

# Tử Vi paradigm tables (miếu/vượng/hãm, chính tinh, cách cục, CDK 18 phi tinh)
# Engine mieu_vuong_ham, chinh_tinh, cach_cuc... đều load runtime
!data/tu_vi/
!data/tu_vi/**/*.json

# Tử Vi Q1 master dicts (NGHĨA sao + cách cục) — concept_dict + cach_cuc_dict load runtime.
# Chỉ 2 file (chuỗi dir re-include để Docker traverse, KHÔNG /** để khỏi kéo cả yi_publishing).
!data/yi_publishing/
!data/yi_publishing/q1_tuvi/
!data/yi_publishing/q1_tuvi/master/
!data/yi_publishing/q1_tuvi/master/concepts_index.json
!data/yi_publishing/q1_tuvi/master/cach_cuc_index.json

# Docs (not needed in runtime image) — except citation markdown:
# .md files trong skills/kinh-dich/ phải vào image cho RAG luận sâu

# Logs
*.log
**/_logs/

# IDE / OS
.DS_Store
.idea/
.vscode/
.cursor/
.claude/

# Git
.git/
.gitignore
.dockerignore

# Docs (not needed in runtime image)
docs/
**/*.md
!README.md
# Knowledge citations - keep these .md files for RAG luận sâu
!data/hermes_yi/skills/kinh-dich/**/*.md
!data/hermes_yi/skills/kinh-dich/INDEX.md
# Restored books markdown (cho live reading)
!data/restored_books/**/content.md
# Sách bundle vào frontend (import ?raw lúc build) — phải vào Docker context
!client/webapp/src/content/*.md

# Tests
tests/
pytest.ini

# Vendor (already-installed third-party Python envs)
vendor/

# Misc
figures/
"thư viện sách/"
**/*.rtf
**/*.pdf
# PDF sách bundle vào frontend (Vite copy public/ → dist) — phải vào Docker context
!client/webapp/public/*.pdf

# Backup / temp
*.bak
*.tmp
deep-research-report.md
