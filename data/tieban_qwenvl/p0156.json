{"page_pdf": 156, "items": [{"so": "七", "tuoi": "三十六", "van": "分有嫡母生母继母"}, {"so": "八", "tuoi": "三十六", "van": "挣得家业无恙身遭心多磨障"}, {"so": "九", "tuoi": null, "van": "有妻若无妻其实靠著妻"}, {"so": "二二三〇十", "tuoi": "+ 二", "van": "池塘新雨湿春水漾金鳞"}, {"so": "一", "tuoi": "三十九", "van": "求之十九成之十一"}, {"so": "二", "tuoi": "三十七", "van": "浮云卷尽碧天空春风融和瑞气多"}, {"so": "三", "tuoi": "三十八", "van": "颠颠沛沛怀几撞碎"}, {"so": "四", "tuoi": "三十七", "van": "好花将开风雨又来"}, {"so": "五", "tuoi": "二十二", "van": "东西少有忧云罩屋檐头"}, {"so": "六", "tuoi": null, "van": "室家相宜夫妻乐趣"}, {"so": "七", "tuoi": null, "van": "命犯呻吟杀当有半身不遂"}, {"so": "八", "tuoi": "二十四", "van": "烦恼无忧煎谋来为可忧"}, {"so": "九", "tuoi": "+ 四", "van": "恍恍惚惚不但人嗔且有鬼喷"}, {"so": "二二四〇十", "tuoi": null, "van": null}, {"so": "一", "tuoi": "四十八", "van": "前后有阻并无安土"}, {"so": "二", "tuoi": "六十七", "van": "牛羊恐破财未免是非多"}, {"so": "三", "tuoi": "六十八", "van": "爵与齿俱高有德者是为达尊"}, {"so": "四", "tuoi": "七十九", "van": "生姿气禀钟灵出他日龙门必占先"}, {"so": "五", "tuoi": null, "van": "是个朝阳补衲僧高山流水出红尘"}, {"so": "六", "tuoi": "三十七", "van": "舟车往来关津有阻"}, {"so": "七", "tuoi": null, "van": "金年水年父母早去方合此刻"}, {"so": "八", "tuoi": null, "van": "血盆星临当产死其妻"}, {"so": "九", "tuoi": "五十五", "van": "夫妻本是同林鸟不幸雄者竟先去"}, {"so": "二二五〇十", "tuoi": null, "van": "壮年劳劳碌碌而成家无安闲之日"}, {"so": "一", "tuoi": "二十五", "van": "人事纠缠费尽工夫也破钱"}], "model": "qwen2.5vl:7b", "ocr_at": 1781081013}