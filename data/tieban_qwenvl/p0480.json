{"page_pdf": 480, "items": [{"tap": "子集"}, {"so": "一", "tuoi": "三十六", "van": "孝服重重父母双亡"}, {"so": "二", "tuoi": "六十七", "van": "子死妻亡两度刑伤"}, {"so": "三", "tuoi": "六十八", "van": "父犬母猪天所定也"}, {"so": "四", "tuoi": null, "van": "人生有数劳劳碌碌之中总是空"}, {"so": "五", "tuoi": null, "van": "妻命乙酉生姻绿定矣"}, {"so": "六", "tuoi": null, "van": "再娶戊戌之妻方免其刑"}, {"so": "七", "tuoi": null, "van": "哀哉母亡喜也生子"}, {"so": "八", "tuoi": null, "van": "双亲辞世日总是一年全"}, {"so": "九", "tuoi": null, "van": "笔绘千般景致描来万里江山"}, {"so": "一", "tuoi": "三十七", "van": "父母全属猪先天注定"}, {"so": "二", "tuoi": null, "van": "金水之年乐舞生方合此卦"}, {"so": "三", "tuoi": null, "van": "东成西就般般遂生意谋为事事亨"}, {"so": "四", "tuoi": null, "van": "妻命辛亥生姻缘注定"}, {"so": "五", "tuoi": null, "van": "主人有刑再娶庚戌"}, {"so": "六", "tuoi": null, "van": "母死生子一忧一喜"}, {"so": "七", "tuoi": null, "van": "遇得东风急挂帆顺风方便往回还"}, {"so": "八", "tuoi": null, "van": "双亲全亡一年二孝"}, {"so": "九", "tuoi": null, "van": "金钟出治方成器运至中年定起家"}], "model": "qwen2.5vl:7b", "ocr_at": 1781089030}