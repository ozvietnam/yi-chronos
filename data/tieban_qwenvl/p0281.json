{"page_pdf": 281, "items": [{"so": "一", "tuoi": "三", "van": "招得父有寿在堂是也"}, {"so": "二", "tuoi": "四", "van": "善事翁姑贤能莫及"}, {"so": "三", "tuoi": "三十四", "van": "鸦鹊报凶又报吉"}, {"so": "四", "tuoi": "三十九", "van": "好树扶疏绿映浓吹嘘之力在东风"}, {"so": "五", "tuoi": "八十九", "van": "寿域司签九十年寿星昨夜现中天"}, {"so": "六", "tuoi": "九", "van": "数有六子得以送老"}, {"so": "七", "tuoi": "三四岁", "van": "四时佳处莫如春"}, {"so": "八", "tuoi": "九", "van": "妻配虎命方能白首于飞"}, {"so": "九", "tuoi": "九", "van": "数有九子五子送老"}, {"so": "五三七〇十", "tuoi": "十", "van": "兄弟十人中断惜离群"}, {"so": "一", "tuoi": "五十九", "van": "春雨花枝茂枝枯而复荣"}, {"so": "二", "tuoi": "六", "van": "命犯孤刑未出嫁而克夫"}, {"so": "三", "tuoi": "七十五", "van": "数有八子五子送老"}, {"so": "四", "tuoi": "七十六", "van": "金谷园中列绮罗山珍海味列于前"}, {"so": "五", "tuoi": "十八", "van": "高椿之树正扶苏不料狂风吹折枝"}, {"so": "六", "tuoi": "四十九", "van": "寿曰于此矣"}, {"so": "七", "tuoi": "五", "van": "乐事喜相逢东林鸦噪不为凶"}, {"so": "八", "tuoi": "三十五", "van": "行船走马防风浪不是人差命亦差"}, {"so": "九", "tuoi": "二十七", "van": "红鸾照命是小登科"}], "model": "qwen2.5vl:7b", "ocr_at": 1781084532}