{"page_pdf": 574, "items": [{"so": "一", "tuoi": "七", "van": "父亲有寿亡女亦当悲"}, {"so": "二", "tuoi": "十", "van": "为人慎重终无阻逆之虞"}, {"so": "三", "tuoi": "六", "van": "添丁未久又逢凶"}, {"so": "四", "tuoi": "七", "van": "良人有刑再嫁癸已"}, {"so": "五", "tuoi": "八", "van": "偏房虽多不结子娶得鸡命许生儿"}, {"so": "六", "tuoi": "三十四", "van": "生子入泮二喜临门"}, {"so": "七", "tuoi": "九", "van": "克夫之年悲莫大焉"}, {"so": "八", "tuoi": "三十六", "van": "卜商之叹见于此年"}, {"so": "九", "tuoi": "十", "van": "琴瑟正相调岂料一朝弦断"}, {"so": "一〇", "tuoi": "二", "van": "衣钵传来空寂寂生涯到处是良缘"}, {"so": "一〇一", "tuoi": "三", "van": "岁科之年名定高列"}, {"so": "一〇二", "tuoi": "六", "van": "良人有刑再嫁甲申"}, {"so": "一〇三", "tuoi": "七", "van": "侧室虽多不结子娶得犬命许生儿"}, {"so": "一〇四", "tuoi": "八", "van": "二喜临门生子采芹"}, {"so": "一〇五", "tuoi": "九", "van": "父死之年悲莫大焉"}, {"so": "一〇六", "tuoi": "一〇七", "van": "卜商之叹定在此年"}], "model": "qwen2.5vl:7b", "ocr_at": 1781091133}