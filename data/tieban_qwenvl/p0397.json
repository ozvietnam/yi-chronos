{"page_pdf": 397, "items": [{"so": "一", "tuoi": "二", "van": "兄弟七人我在空门"}, {"so": "二", "tuoi": "三", "van": "花外莺声巧春风草色新"}, {"so": "三", "tuoi": "四", "van": "淹淹晦滞流年大不宁"}, {"so": "四", "tuoi": "五", "van": "财帛破耗流年多滞"}, {"so": "五", "tuoi": "六", "van": "安于淡薄识父母心"}, {"so": "六", "tuoi": "七", "van": "当有五母之称"}, {"so": "七", "tuoi": "八", "van": "虎兕出于柙征夫不能前"}, {"so": "八", "tuoi": "九", "van": "子秀夫荣谁可及荣华直到七旬春"}, {"so": "八二六〇十", "tuoi": null, "van": "夫妻同庚得齐眉鸳鸯何年晚分飞"}, {"so": "一", "tuoi": "二十二", "van": "暗中摸索处隙路有光阴"}, {"so": "二", "tuoi": "二 十", "van": "破家一床蝴蝶梦惊散鸳鸯不成眠"}, {"so": "三", "tuoi": "三十四", "van": "数该生子"}, {"so": "四", "tuoi": "五十九", "van": "上苑奇花呈富贵庭前绿竹耀祥光"}, {"so": "五", "tuoi": "五十九", "van": "南极祥光照我身此年幸有花甲临"}, {"so": "六", "tuoi": "六十一", "van": "南北江山争秀丽风前花柳正繁华"}, {"so": "七", "tuoi": "六十一", "van": "送老四子三枝挺秀"}, {"so": "八", "tuoi": "八", "van": "子许成双是良材量有埋蛇救蚁功"}, {"so": "九", "tuoi": "九", "van": "利子益夫正好助家之际"}, {"so": "八二七〇十", "tuoi": null, "van": "无子似有子副室之儿送我终"}, {"so": "一", "tuoi": null, "van": "四德互兼全巨家主权"}, {"so": "二", "tuoi": null, "van": "水年火年俱得子无奈土命年先去"}, {"so": "三", "tuoi": null, "van": "少享庇阴之年晚启后人事业"}, {"so": "四", "tuoi": null, "van": "送老三子两朵名花开玉树"}, {"so": "五", "tuoi": null, "van": "克勤克俭能内助一生衣禄自安然"}, {"so": "六", "tuoi": "四十二", "van": "俄然风卷浮云至中天日色尽光辉"}, {"so": "七", "tuoi": null, "van": "伯道无儿天道绝幸有犹子唱骊歌"}], "model": "qwen2.5vl:7b", "ocr_at": 1781087264}