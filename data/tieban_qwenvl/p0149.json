{"page_pdf": 149, "items": [{"so": "一", "tuoi": "五十二", "van": "今时还是旧时人人事如今又一新"}, {"so": "二", "tuoi": "三十八", "van": "父母生于水年终于土年方合此刻"}, {"so": "三", "tuoi": "三十七", "van": "行止非人所能造物还须有主"}, {"so": "四", "tuoi": "五十九", "van": "连年不如意老运享平安"}, {"so": "五", "tuoi": "四十四", "van": "喜鹊营巢久鸠居却有迁"}, {"so": "六", "tuoi": "十七", "van": "平安二字不必问行藏"}, {"so": "七", "tuoi": "三十四", "van": "享平安之福克享其成"}, {"so": "八", "tuoi": null, "van": "常忆故园惟自叹将何鱼雁寄流离"}, {"so": "九", "tuoi": "四十五", "van": "福自适人平安之吉"}, {"so": "一", "tuoi": "三十四", "van": "烟霞晓未收江头款可试鱼钩"}, {"so": "二", "tuoi": null, "van": "兄弟三人俱叨荣贵"}, {"so": "三", "tuoi": "二十九", "van": "恍恍惚惚不但人嗔且有鬼嗔"}, {"so": "四", "tuoi": "四十六", "van": "云行雨施品物流行"}, {"so": "五", "tuoi": "三十八", "van": "先甲三日幸乃吉后甲三日幸乃昌"}, {"so": "六", "tuoi": "三十六", "van": "曰畅曰焕庶草蕃芜"}, {"so": "七", "tuoi": "四十九", "van": "田翁乃积丰稔岁不枉春犁带雨耕"}, {"so": "八", "tuoi": null, "van": "父母生于水年终于水年合纳音方合此刻"}, {"so": "九", "tuoi": null, "van": "兄弟四人俱叨荣耀"}, {"so": "一〇", "tuoi": "三十九", "van": "小宋应熊占二子当先"}, {"so": "一", "tuoi": "三十九", "van": "是是非非支持度日"}, {"so": "二", "tuoi": null, "van": "叠叠重重刑尔室四旬迟配得和谐"}, {"so": "三", "tuoi": null, "van": null}], "model": "qwen2.5vl:7b", "ocr_at": 1781080783}