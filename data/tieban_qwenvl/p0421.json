{"page_pdf": 421, "items": [{"so": "一", "tuoi": "三", "van": "阵伍中姓名不免"}, {"so": "四", "tuoi": "六十三", "van": "朝霞映日画堂彩色交加"}, {"so": "五", "tuoi": "二十七", "van": "金风萧杀不可当空中萱花别故乡"}, {"so": "六", "tuoi": "二十四", "van": "科甲及第"}, {"so": "七", "tuoi": null, "van": "拮据不求克享其子"}, {"so": "八", "tuoi": null, "van": "数定三军客终身乘一马"}, {"so": "九", "tuoi": "三十九", "van": "林木春将近焕然景色新"}, {"so": "八八七〇十", "tuoi": "三十三", "van": "安然获福俾尔渐昌"}, {"so": "一", "tuoi": null, "van": "此刻生人死于木火之年方合"}, {"so": "二", "tuoi": null, "van": "幼年承继数该两处双亲"}, {"so": "三", "tuoi": "三十二", "van": "前途有推呼惊防一点无"}, {"so": "四", "tuoi": "七八岁", "van": "此日虽憔翠当年有吉星"}, {"so": "五", "tuoi": "六七十九", "van": "花移春苑娇娆好全赖栽培雨露深"}, {"so": "六", "tuoi": "五十二", "van": "莫道浮云无骤雨须防尺水起波涛"}, {"so": "七", "tuoi": "六十八", "van": "风前之烛危而难免"}, {"so": "八", "tuoi": "六十四", "van": "竹松古劲日秋色正春容"}, {"so": "九", "tuoi": "四十七", "van": "水涨长江两岸平孤舟自在可前行"}, {"so": "八八八〇十", "tuoi": "二十四", "van": "乡试中式"}, {"so": "一", "tuoi": "七十三", "van": "孝子至此之称不亚斑斓之乐"}, {"so": "二", "tuoi": "三十一", "van": "寿少回也一春矣"}, {"so": "三", "tuoi": null, "van": "秋风桂子花开晚海一蟠桃结子迟"}, {"so": "四", "tuoi": "三四岁", "van": "其年虽好难免啾唧"}, {"so": "五", "tuoi": "四十二", "van": "一片白云迷户内孝服相催"}, {"so": "六", "tuoi": "四十四", "van": "一泓清水映满堂春色放光明"}, {"so": "七", "tuoi": "三十六", "van": "恍恍惚惚不但人嗔且有鬼喷"}, {"so": "八", "tuoi": "五十六", "van": "瑞日祥光珠翠现轻风吹动绮罗香"}], "model": "qwen2.5vl:7b", "ocr_at": 1781087797}