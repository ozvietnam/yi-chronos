{"page_pdf": 298, "items": [{"so": "一", "tuoi": "五十九十", "van": "配得金水之夫方合此卦"}, {"so": "二", "tuoi": "五十八", "van": "太平无事悠悠顺意"}, {"so": "三", "tuoi": "五十二", "van": "时通时蹇或进或退"}, {"so": "四", "tuoi": "三十五六", "van": "所谋不合图之何益"}, {"so": "五", "tuoi": "七十八", "van": "而今燕喜连绵至柳絮桃花共一园"}, {"so": "六", "tuoi": "四十九", "van": "经谈松树下得意月长明"}, {"so": "七", "tuoi": "二十一", "van": "有经营之才无经营之运"}, {"so": "八", "tuoi": "二十九", "van": "风云一时新桃花柳絮青"}, {"so": "九", "tuoi": "一二岁", "van": "泽萼桃蕊初春风草欲青"}, {"so": "五八〇〇十", "tuoi": "四十三四", "van": "进步而周旋春风备马鞭"}, {"so": "一", "tuoi": "五十九十", "van": "破耗虽不幸失中之有得"}, {"so": "二", "tuoi": "三十二", "van": "幼年行乐无日不悠"}, {"so": "三", "tuoi": "三十二", "van": "协领之职数由前定"}, {"so": "四", "tuoi": "六", "van": "严父早折母又重婚"}, {"so": "五", "tuoi": "四十九", "van": "日色融融几度清风"}, {"so": "六", "tuoi": "八", "van": "借问一生身外事遇猴之年是归期"}, {"so": "七", "tuoi": "二 十", "van": "玉折兰催古今同恨"}, {"so": "五八一〇十", "tuoi": null, "van": "乡科中选"}], "model": "qwen2.5vl:7b", "ocr_at": 1781084884}