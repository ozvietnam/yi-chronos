{"page_pdf": 327, "items": [{"so": "一", "tuoi": "一", "van": "勤俭持家衣禄足旺夫益子寿元长"}, {"so": "二", "tuoi": "二", "van": "将军一箭最难当三岁孩儿身便亡"}, {"so": "三", "tuoi": "七十一", "van": "夫虽有寿别之亦苦"}, {"so": "四", "tuoi": "九十一", "van": "老来又精神枯木又逢春"}, {"so": "五", "tuoi": null, "van": "以举人而知县数由前定"}, {"so": "六", "tuoi": null, "van": "父先故于水年母生年属火方合"}, {"so": "七", "tuoi": null, "van": "妻生二子妾生一儿"}, {"so": "八", "tuoi": "三十六", "van": "数该生子"}, {"so": "九", "tuoi": "四十三", "van": "子规啼落楼头月一枕鸳鸯梦不成"}, {"so": "六五二〇十", "tuoi": "七十九", "van": "不出户庭福自来寻"}, {"so": "一", "tuoi": "四十三", "van": "不足不驳难相逐"}, {"so": "二", "tuoi": "四十四", "van": "命带暗杀三岁而亡"}, {"so": "三", "tuoi": null, "van": "有子惟宜先抱女原来有数定先知"}, {"so": "四", "tuoi": null, "van": "人有黄金满玉楼我有妙术度春秋"}, {"so": "五", "tuoi": "四十五", "van": "当宴鹿鸣"}, {"so": "六", "tuoi": null, "van": "兔走乌飞领袖青衿换布衣"}, {"so": "七", "tuoi": null, "van": "未嫁夫先死女之不幸"}, {"so": "八", "tuoi": null, "van": "前妻三子后妻无儿"}, {"so": "九", "tuoi": "六十一", "van": "绨绤遇寒风时当有待"}, {"so": "六五三〇十", "tuoi": "六十二", "van": "古镜尘蒙晦而不明"}, {"so": "一", "tuoi": null, "van": "再升知县"}], "model": "qwen2.5vl:7b", "ocr_at": 1781085489}