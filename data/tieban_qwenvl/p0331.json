{"page_pdf": 331, "items": [{"so": "一", "tuoi": "五十三", "van": "平章百姓百姓昭明"}, {"so": "二", "tuoi": "五十四", "van": "初任有司再升钦取"}, {"so": "三", "tuoi": null, "van": "若问阳生何日止一程直至六旬余"}, {"so": "四", "tuoi": null, "van": "风卷灯花暗又明摇摇不定影纵横"}, {"so": "五", "tuoi": "七十五", "van": "晚年生子之喜"}, {"so": "六", "tuoi": "三十三", "van": "当为招为运有不齐"}, {"so": "七", "tuoi": "七十三", "van": "晚来丧天之年悲也"}, {"so": "八", "tuoi": "五十三", "van": "安步前驱不必问路疏"}, {"so": "九", "tuoi": null, "van": "命有千金数子享得终身"}, {"so": "六六二〇十", "tuoi": null, "van": "贵及出嫁先尽定行"}, {"so": "一", "tuoi": "三十五", "van": "柳上不舒眉度日强支持"}, {"so": "二", "tuoi": null, "van": null}, {"so": "三", "tuoi": null, "van": null}, {"so": "四", "tuoi": null, "van": "水火之年克妻方合此卦"}, {"so": "五", "tuoi": "四十二", "van": "居易以俟不行险以求"}, {"so": "六", "tuoi": null, "van": "命中杀重当刑七夫"}, {"so": "七", "tuoi": "七十", "van": "日行中天何期罗计掩其光"}, {"so": "八", "tuoi": null, "van": null}, {"so": "九", "tuoi": "二十九", "van": "新竹苍苍嫩柳丛庭前茫茫物正蒙"}, {"so": "六六三〇十", "tuoi": "四十四", "van": "老椿已被风吹折难免三年泣血悲"}, {"so": "一", "tuoi": "十五六", "van": "妄意空花难以入手"}, {"so": "二", "tuoi": "五十九", "van": "岁月渐亨碧天映冰壶之烂"}, {"so": "三", "tuoi": "六十七", "van": "大风拔树木灾害并至"}], "model": "qwen2.5vl:7b", "ocr_at": 1781085572}