{"page_pdf": 426, "items": [{"so": "一", "tuoi": "四十五六", "van": "元亨利贞大有所获"}, {"so": "二", "tuoi": "三四岁", "van": "此年无灾略见平安"}, {"so": "三", "tuoi": "三十四五六", "van": "天喜吉来临无灾无难"}, {"so": "四", "tuoi": null, "van": "全飞四雁我何受伤"}, {"so": "五", "tuoi": "七十八", "van": "前有余月可以进步"}, {"so": "六", "tuoi": "三十七三十八", "van": "夜雨正逢春万物生和气"}, {"so": "七", "tuoi": null, "van": "不从文武科中出另有黄堂一丈夫"}, {"so": "八", "tuoi": null, "van": "虎年文昌照命必有青衣换锦衣"}, {"so": "九", "tuoi": null, "van": "高云锦帐诚堪羡冷落青毡不用忧"}, {"so": "九〇〇〇十", "tuoi": null, "van": "夫大一年前生注定"}], "model": "qwen2.5vl:7b", "ocr_at": 1781087898}