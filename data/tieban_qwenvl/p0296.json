{"page_pdf": 296, "items": [{"so": "一", "tuoi": "五十五", "van": "事得所欲无为不足"}, {"so": "二", "tuoi": "二十三", "van": "当谐鸾凤如鱼得水"}, {"so": "三", "tuoi": "六十三", "van": "其年恶曜攻身虽防危险"}, {"so": "四", "tuoi": null, "van": "真假五子得以送老"}, {"so": "五", "tuoi": "六十七", "van": "飞符夹死符啾唧总不知"}, {"so": "六", "tuoi": "四十五", "van": "时进时退不一"}, {"so": "七", "tuoi": "四十一", "van": "喜事可以逍遥悠悠顺培"}, {"so": "八", "tuoi": "四十二", "van": "半夜潮生犬不惊但得财聚又成名"}, {"so": "九", "tuoi": "六十四", "van": "该生一子"}, {"so": "五七五〇十", "tuoi": null, "van": "苦功用尽许君洋水自生香"}, {"so": "一", "tuoi": "七十九", "van": "福禄随人健旺精神"}, {"so": "二", "tuoi": "十四", "van": "椿树已成风木恨难免三年泣血悲"}, {"so": "三", "tuoi": "四十七", "van": "谋事有人成得意马蹄轻"}, {"so": "四", "tuoi": "五十一", "van": "事事从容怀抱宽金风送暑得清凉"}, {"so": "五", "tuoi": "四十六", "van": "东西路可通行船遇顺风"}, {"so": "六", "tuoi": "三十三", "van": "浮云卷尽月重明灾晦消除福自生"}, {"so": "七", "tuoi": "三十八", "van": "坚木胶结舟倾中流"}, {"so": "八", "tuoi": "七十八", "van": "其年恶曜攻身须防危险"}, {"so": "九", "tuoi": "三十三", "van": "浓霜连夜落萱花被凋残"}, {"so": "五七六〇十", "tuoi": "六十三", "van": "居官不如居家治国不如治家"}], "model": "qwen2.5vl:7b", "ocr_at": 1781084844}