{"page_pdf": 152, "items": [{"so": "一", "tuoi": "三十三", "van": "人不遂黄金黄金转遂人"}, {"so": "二", "tuoi": "三十一", "van": "相照有丧门衣裳白一番"}, {"so": "三", "tuoi": "一岁", "van": "并蒂双莲出奇哉两朵开"}, {"so": "四", "tuoi": null, "van": "于囊于囊千仓万箱"}, {"so": "五", "tuoi": null, "van": "三场未幸登科甲一贡承恩可牧民"}, {"so": "六", "tuoi": "二十二", "van": "图得东来缺了西还是君家运未齐"}, {"so": "七", "tuoi": null, "van": "此刻注定人青云土年人泮金年中举"}, {"so": "八", "tuoi": "四十二", "van": "终日乾乾夕惕若厉无咎"}, {"so": "九", "tuoi": null, "van": "双亲俱去世母先辞别父难留"}, {"so": "二一四〇十", "tuoi": null, "van": "再任黄堂数皆前定"}, {"so": "一", "tuoi": null, "van": "补授照磨数由前定"}, {"so": "二", "tuoi": "四十五", "van": "穷通得失皆前定何必怨天又尤人"}, {"so": "三", "tuoi": null, "van": "木年母先终大合此刻"}, {"so": "四", "tuoi": null, "van": "官至钦命知县数由前定"}, {"so": "五", "tuoi": null, "van": "窥见室家之好牢拴穴隙之情"}, {"so": "六", "tuoi": null, "van": "小车无轭其何以行"}, {"so": "七", "tuoi": "四十二", "van": "子产三丁乐奏几般音"}, {"so": "八", "tuoi": null, "van": "禄马荣华得阶八座之荣"}, {"so": "九", "tuoi": "六十一", "van": "木欣欣而向荣春光明媚"}, {"so": "二一五〇十", "tuoi": "四十五四十六", "van": "其年丧门相照当有哭泣之哀"}, {"so": "六", "tuoi": null, "van": "母先故于水年父生年属于金方合此刻"}, {"so": "七", "tuoi": "五十二", "van": "母故之年自叹何恃"}, {"so": "八", "tuoi": null, "van": "内助不相和狮吼是非多"}, {"so": "九", "tuoi": "六十一", "van": "取此东风候扁舟渡万山"}, {"so": "二一三〇十", "tuoi": "六十三六十四", "van": "大生两口任君详之"}], "model": "qwen2.5vl:7b", "ocr_at": 1781080880}