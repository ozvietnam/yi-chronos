{"page_pdf": 377, "items": [{"so": "一", "tuoi": "三十一", "van": "翁姑俱丧妇之不幸"}, {"so": "二", "tuoi": "三十二", "van": "一阳初动候黄钟得合天心困始通"}, {"so": "三", "tuoi": "二十九", "van": "断弦之忧此年难免"}, {"so": "四", "tuoi": null, "van": "只身一人方合此刻"}, {"so": "五", "tuoi": null, "van": "借问一生身外事遇猪之年是归期"}, {"so": "六", "tuoi": "四十四", "van": "仕途变幻官讼交加"}, {"so": "七", "tuoi": "四十三", "van": "兴兵结怨吴越交争"}, {"so": "八", "tuoi": "四十四", "van": "五彩绳牵月老画眉京兆许张郎"}, {"so": "九", "tuoi": null, "van": "百岁欠一春含笑入黄泉"}, {"so": "七七七〇十", "tuoi": "九十九", "van": "及时梅萼枝枝秀春信前来到画堂"}, {"so": "二", "tuoi": "三十五", "van": "猛虎出松林吼啸风自生"}, {"so": "三", "tuoi": "三十六", "van": "多有助夫之德又招富贵贤郎"}, {"so": "四", "tuoi": "四十四", "van": "马头带剑掌握兵权"}, {"so": "五", "tuoi": "四十三", "van": "老椿风吹折三年泣血悲"}, {"so": "六", "tuoi": "三十五", "van": "钦命典试"}, {"so": "七", "tuoi": "四十七", "van": "篱竹独舒元亮兴江莼忽起季鹰情"}, {"so": "八", "tuoi": "三十八", "van": "到处交情容易投清风车马贵人留"}, {"so": "九", "tuoi": "三十九", "van": "雨过有人耕野绿月明无犬吠花阴"}, {"so": "七七八〇十", "tuoi": "五十四", "van": "元亨利贞室人之庆"}, {"so": "一", "tuoi": "三十九", "van": "喜遇青龙现安然不须忧"}, {"so": "二", "tuoi": "三十七", "van": "命照武英弓马入泮"}, {"so": "三", "tuoi": "十七", "van": "三月艳阳天游人乐少年"}, {"so": "四", "tuoi": "二十一", "van": "含哺虽有喜进退且待时"}, {"so": "五", "tuoi": "四", "van": "不惑之时孝服临堂上栋梁倾"}, {"so": "六", "tuoi": null, "van": "劝君勤俭为生理自有兴家发达时"}], "model": "qwen2.5vl:7b", "ocr_at": 1781086757}