{"page_pdf": 310, "items": [{"so": "一", "tuoi": "一〇一〇十", "van": "用之帝王师不用岩谷叟"}, {"so": "二", "tuoi": "四十六", "van": "无端烦恼谁人识惟欠东风只自知"}, {"so": "三", "tuoi": "三十八", "van": "问今之父父母全卜他之年父先去"}, {"so": "四", "tuoi": "六十五", "van": "严霜上鬓来东风吹下去"}, {"so": "五", "tuoi": "五岁", "van": "童子五岁难免灾晦"}, {"so": "六", "tuoi": "七", "van": "穷通皆由命切莫强求谋"}, {"so": "七", "tuoi": "八", "van": "达将连驷骋穷即蓬荜行"}, {"so": "八", "tuoi": "九", "van": "凉风至暑气除心事安舒喜自如"}, {"so": "九", "tuoi": "六〇九〇十", "van": "时乖命亦乖浑沌无心绪"}, {"so": "一", "tuoi": "二", "van": "偶因行事徒差错误了终身知未知"}, {"so": "二", "tuoi": "三", "van": "半为儒者半为医"}, {"so": "三", "tuoi": "四", "van": "妻早子亦早人生大幸好"}, {"so": "四", "tuoi": "五", "van": "华年凋谢天地老人生多情偏悲思"}, {"so": "五", "tuoi": "六", "van": "蟋蟀最无知亦悲年运穷"}, {"so": "六", "tuoi": "七", "van": "超然物外时时梅月松风"}, {"so": "七", "tuoi": "八", "van": "闷闷飞不堪言蹑足不知前"}, {"so": "八", "tuoi": "九", "van": "一往因飘蓬俯仰又似悲"}, {"so": "九", "tuoi": "六〇八〇十", "van": "东西任所之宇宙何其宽"}, {"so": "一", "tuoi": "五", "van": "金风除暑气心舒喜自如"}, {"so": "二", "tuoi": "六", "van": "惆怅关山外运限有奇灾神力可保不能一旦来"}, {"so": "三", "tuoi": "七", "van": "不意之中福自臻恩星相照福来临"}, {"so": "四", "tuoi": "八", "van": "命带文昌名登金榜"}, {"so": "五", "tuoi": "九", "van": "时运不通连遭几度"}, {"so": "六", "tuoi": "十", "van": "如葵偏爱日掩映不为光"}], "model": "qwen2.5vl:7b", "ocr_at": 1781085113}