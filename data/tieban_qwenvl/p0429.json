{"page_pdf": 429, "items": [{"so": "一", "tuoi": "四十七", "van": "闭户静生是非临门"}, {"so": "二", "tuoi": "四十八", "van": "早运迟迟晚运美梅花只到雪时奇"}, {"so": "三", "tuoi": "四十九", "van": "父鼠母兔先天注定"}, {"so": "四", "tuoi": "五十", "van": "无本手艺虽然好失多得少见阴功"}, {"so": "五", "tuoi": "三十三", "van": "金木相克难免狱中刑罪之苦"}, {"so": "六", "tuoi": "三十四", "van": "大小安然福禄绵绵"}, {"so": "七", "tuoi": "三十五", "van": "柔而能刚不类颂仲山甫"}, {"so": "八", "tuoi": "三十六", "van": "数定幼学不正艺去邪归正发财源"}, {"so": "九", "tuoi": "三十七", "van": "父鼠母龙数由前定"}, {"so": "十", "tuoi": "三十八", "van": "命带天雄犯计星无本生理好难免后来悔"}, {"so": "十一", "tuoi": "三十九", "van": "天囚化马难免监中破财之悔幸逢盛之年"}, {"so": "十二", "tuoi": "四十", "van": "好读奇书字博士孙杨不遇枉徒然"}, {"so": "十三", "tuoi": "四十一", "van": "学得一般好手艺不要本钱却行时"}, {"so": "十四", "tuoi": "四十二", "van": "乍暖梅花犹半吐初开柳眼未全舒"}, {"so": "一", "tuoi": "四十三", "van": "命犯恶曜定耳不闻言之声"}, {"so": "二", "tuoi": "四十四", "van": "早运迟晚运美花开结子福悠悠"}], "model": "qwen2.5vl:7b", "ocr_at": 1781088020}