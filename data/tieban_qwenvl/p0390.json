{"page_pdf": 390, "items": [{"so": "一", "tuoi": "二十八", "van": "石旁有皮防破"}, {"so": "二", "tuoi": "二十一", "van": "兄弟三人中断惜离群"}, {"so": "三", "tuoi": "二十二", "van": "池塘水月新如钩梦断邯郸眉黛愁"}, {"so": "四", "tuoi": null, "van": "兄弟四人我在空门"}, {"so": "五", "tuoi": "七十三", "van": "福寿康宁精神倍爽"}, {"so": "六", "tuoi": "四十五", "van": "风静月华明高阁奏笛声"}, {"so": "七", "tuoi": "五十四", "van": "椿庭有寿狂风吹折"}, {"so": "八", "tuoi": "二十五", "van": "此时得成功贵人指引喜匆匆"}, {"so": "九", "tuoi": "二十六", "van": "金殿传鲈人生大幸"}, {"so": "一〇一〇十", "tuoi": null, "van": "五福寿为先平安乐天年"}, {"so": "一", "tuoi": "二十三", "van": "若娶偏房发生一子"}, {"so": "二", "tuoi": null, "van": "鸟鹊逢林未可即安"}, {"so": "三", "tuoi": null, "van": "壬辰之年进士及第"}, {"so": "四", "tuoi": "五十五", "van": "乡科题名"}, {"so": "五", "tuoi": "二十七", "van": "江头昨夜报潮生侵晓楼头水正平"}, {"so": "六", "tuoi": "二十八", "van": "问名问利名不如利"}, {"so": "七", "tuoi": null, "van": "桃李春风花不结三秋丹桂一枝春"}, {"so": "八", "tuoi": null, "van": "佳人命运乖配得郎不才"}, {"so": "九", "tuoi": null, "van": "土年使要离乡井"}], "model": "qwen2.5vl:7b", "ocr_at": 1781087050}